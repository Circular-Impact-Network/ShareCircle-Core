// Prisma schema for ShareCircle

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
        
// Enums for Circle Management
enum MemberRole {
  ADMIN
  MEMBER
}

enum JoinType {
  CREATED
  CODE
  LINK
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  SYSTEM
}

enum AttachmentType {
  IMAGE
  FILE
}

// Enums for Borrowing/Request Management
enum ItemRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum BorrowRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum BorrowQueueStatus {
  WAITING
  READY
  SKIPPED
  CANCELLED
}

enum BorrowTransactionStatus {
  ACTIVE
  LENDER_CONFIRMED
  BORROWER_CONFIRMED
  RETURN_PENDING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  // Item request notifications
  ITEM_REQUEST_CREATED
  ITEM_REQUEST_FULFILLED
  // Borrow request notifications
  BORROW_REQUEST_RECEIVED
  BORROW_REQUEST_APPROVED
  BORROW_REQUEST_DECLINED
  // Queue notifications
  QUEUE_POSITION_UPDATED
  QUEUE_ITEM_READY
  // Handoff notifications
  ITEM_HANDOFF_CONFIRMED
  ITEM_RECEIVED_CONFIRMED
  // Return notifications
  RETURN_REQUESTED
  RETURN_CONFIRMED
  // Message notifications
  NEW_MESSAGE
  // Circle admin actions
  ITEM_REMOVED_FROM_CIRCLE
}

enum NotificationStatus {
  UNREAD
  READ
}

// User model with requested fields
model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime? @map("email_verified")
  phoneVerified     DateTime? @map("phone_verified")
  image             String?
  hashed_password   String?
  // Stamped on every password change or reset. Any JWT minted before this instant is refused,
  // so a stolen session cannot outlive the password it was obtained under.
  password_changed_at DateTime? @map("password_changed_at")
  phone_number      String?   @unique
  country_code      String?
  // Set when the guided tour is finished or skipped. Stored per account rather than per browser so
  // it does not restart on every new device the user signs in from.
  tour_completed_at DateTime? @map("tour_completed_at")
  address           String?
  zip_code          String?
  state             String?
  country           String?
  profile_media_url String?
  date_of_birth     DateTime? @map("date_of_birth")
  latitude          Decimal?  @db.Decimal(10, 8)
  longitude         Decimal?  @db.Decimal(11, 8)
  city              String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Circle relations
  createdCircles    Circle[]       @relation("CircleCreator")
  circleMemberships CircleMember[]

  // Item relations
  items Item[]

  // Chat relations
  conversationsCreated    Conversation[]            @relation("ConversationCreator")
  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]
  messageReceipts         MessageReceipt[]

  // Borrowing relations
  itemRequests            ItemRequest[]
  borrowRequestsAsRequester BorrowRequest[]         @relation("BorrowRequester")
  borrowRequestsAsOwner   BorrowRequest[]           @relation("BorrowOwner")
  borrowQueueEntries      BorrowQueue[]
  borrowTransactionsAsBorrower BorrowTransaction[]  @relation("Borrower")
  borrowTransactionsAsOwner BorrowTransaction[]     @relation("TransactionOwner")
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  pushSendAttempts        PushSendAttempt[]
  notificationPreference  UserNotificationPreference?
  displayPreference       UserDisplayPreference?
  aiUsages                AiUsage[]
  itemRequestActions      ItemRequestAction[]
  feedbacks               Feedback[]

  @@map("users")
}

/**
 * Units, currency and appearance, per account.
 *
 * These lived only in localStorage, so signing in on a new phone silently reverted a user to
 * kilograms and USD — their own data appeared to change. Persisting per account makes the choice
 * follow the user; the browser copy is kept purely as a cache so the first paint does not flash.
 */
model UserDisplayPreference {
  userId     String   @id @map("user_id")
  theme      String   @default("light")
  fontSize   String   @default("md") @map("font_size")
  weightUnit String   @default("kg") @map("weight_unit")
  currency   String   @default("USD")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_display_preferences")
}

/**
 * One row per help-bot request, for quota enforcement and abuse review.
 *
 * `lib/rate-limit.ts` is an in-memory Map: per-process and wiped on every deploy, which makes it a
 * fine burst guard and useless as a spend ceiling on a paid model. Counting here is what actually
 * bounds cost, and it survives restarts.
 */
model AiUsage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  purpose   String
  // Recorded even when a request is refused, so abuse patterns are visible rather than invisible.
  refused   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usages")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Circle model for group management
model Circle {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  inviteCode  String   @unique @map("invite_code")
  // Timestamptz so the expiry is an absolute instant: as a naive `timestamp` the
  // `now() + interval` default resolved through the session TimeZone while Prisma read it
  // back as UTC. See migration 20260731090100_invite_expiry_timestamptz_two_days.
  inviteExpiresAt DateTime @default(dbgenerated("now() + interval '2 days'")) @map("invite_expires_at") @db.Timestamptz(3)
  avatarUrl   String?  @map("avatar_url")
  avatarPath  String?  @map("avatar_path")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy    User           @relation("CircleCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members      CircleMember[]
  items        ItemCircle[]
  itemRequestCircles ItemRequestCircle[]

  // Names are unique per creator, case- and whitespace-insensitively. That needs a
  // functional index — lower(btrim(name)) — which @@unique cannot express, so it exists
  // only in migration 20260731090000_circle_name_unique_per_creator. Do not use
  // `prisma db push` on this table: it would silently drop the index.
  @@index([createdById])
  @@map("circles")
}

// CircleMember model for membership tracking
model CircleMember {
  id       String     @id @default(cuid())
  circleId String     @map("circle_id")
  userId   String     @map("user_id")
  role     MemberRole @default(MEMBER)
  joinType JoinType   @map("join_type")
  joinedAt DateTime   @default(now()) @map("joined_at")
  leftAt   DateTime?  @map("left_at")

  // Relations
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
  @@index([leftAt])
  @@map("circle_members")
}

// Item model for shared items
model Item {
  id           String   @id @default(cuid())
  ownerId      String   @map("owner_id")
  imagePath    String   @map("image_path")
  name         String
  description  String?  @db.Text
  categories   String[] @default([])
  tags         String[] @default([])
  mediaPaths   String[] @default([]) @map("media_paths")
  isAvailable          Boolean   @default(true) @map("is_available")
  archivedAt           DateTime? @map("archived_at")
  estimatedWeightKg    Float?    @map("estimated_weight_kg")
  estimatedNewPriceUsd Float?    @map("estimated_new_price_usd")
  isValueVisible       Boolean   @default(false) @map("is_value_visible")
  // Vector embeddings stored via raw SQL (pgvector)
  embedding    Unsupported("vector(1024)")?
  // Full-text search vector — a DB-managed GENERATED column (see migration
  // 20260716120000_readd_items_search_vector). Declared here only so `db push`
  // never drops it; the generation expression + GIN index live in the DB.
  search_vector Unsupported("tsvector")?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  circles            ItemCircle[]
  borrowRequests     BorrowRequest[]
  borrowQueue        BorrowQueue[]
  borrowTransactions BorrowTransaction[]

  @@index([ownerId])
  @@index([isAvailable])
  @@index([archivedAt])
  @@index([archivedAt, createdAt(sort: Desc)])
  @@map("items")
}

// ItemCircle model for sharing items across multiple circles
model ItemCircle {
  id       String   @id @default(cuid())
  itemId   String   @map("item_id")
  circleId String   @map("circle_id")
  sharedAt DateTime @default(now()) @map("shared_at")

  // Relations
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([itemId, circleId])
  @@index([circleId])
  @@index([itemId])
  @@map("item_circles")
}

model Conversation {
  id            String            @id @default(cuid())
  type          ConversationType  @default(DIRECT)
  createdById   String            @map("created_by")
  lastMessageAt DateTime?         @map("last_message_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  createdBy     User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([createdById])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  pinnedAt       DateTime? @map("pinned_at")
  archivedAt     DateTime? @map("archived_at")
  mutedUntil     DateTime? @map("muted_until")
  deletedAt      DateTime? @map("deleted_at")
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  leftAt         DateTime? @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([deletedAt])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  clientId       String?     @map("client_id")
  body           String      @db.Text
  messageType    MessageType @default(TEXT) @map("message_type")
  contextRef     Json?       @map("context_ref")
  createdAt      DateTime    @default(now()) @map("created_at")
  editedAt       DateTime?   @map("edited_at")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts     MessageReceipt[]
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@unique([senderId, clientId])
  @@map("messages")
}

model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String    @map("message_id")
  userId      String    @map("user_id")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_receipts")
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String         @map("message_id")
  type      AttachmentType @map("type")
  url       String         @map("url")
  metadata  Json?          @map("metadata")
  createdAt DateTime       @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// Item Request - when user can't find an item they need
model ItemRequest {
  id          String            @id @default(cuid())
  requesterId String            @map("requester_id")
  title       String
  description String?           @db.Text
  desiredFrom DateTime?         @map("desired_from")
  desiredTo   DateTime?         @map("desired_to")
  status      ItemRequestStatus @default(OPEN)
  fulfilledBy String?           @map("fulfilled_by") // itemId that fulfilled this request
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  requester User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  circles   ItemRequestCircle[]
  actions   ItemRequestAction[]

  @@index([requesterId])
  @@index([status])
  @@map("item_requests")
}

// Join table for item requests shared to multiple circles
model ItemRequestCircle {
  id            String      @id @default(cuid())
  itemRequestId String      @map("item_request_id")
  circleId      String      @map("circle_id")
  sharedAt      DateTime    @default(now()) @map("shared_at")

  itemRequest ItemRequest @relation(fields: [itemRequestId], references: [id], onDelete: Cascade)
  circle      Circle      @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([itemRequestId, circleId])
  @@index([circleId])
  @@index([itemRequestId])
  @@map("item_request_circles")
}

// Track user-level actions on item requests (ignore, respond)
model ItemRequestAction {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  itemRequestId String      @map("item_request_id")
  action        String      // "IGNORED" or "RESPONDED"
  createdAt     DateTime    @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemRequest ItemRequest @relation(fields: [itemRequestId], references: [id], onDelete: Cascade)

  @@unique([userId, itemRequestId, action])
  @@index([userId])
  @@index([itemRequestId])
  @@map("item_request_actions")
}

// Borrow Request - request to borrow a specific item
model BorrowRequest {
  id          String              @id @default(cuid())
  itemId      String              @map("item_id")
  requesterId String              @map("requester_id")
  ownerId     String              @map("owner_id")
  message     String?             @db.Text
  // Optional occasion the borrow is for (e.g. "Wedding", "Camping trip"). Free text.
  event       String?             @db.Text
  desiredFrom DateTime            @map("desired_from")
  desiredTo   DateTime            @map("desired_to")
  status      BorrowRequestStatus @default(PENDING)
  declineNote String?             @map("decline_note") @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  item        Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requester   User               @relation("BorrowRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner       User               @relation("BorrowOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  transaction BorrowTransaction?

  @@index([itemId])
  @@index([requesterId])
  @@index([ownerId])
  @@index([status])
  @@index([ownerId, status, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
  @@map("borrow_requests")
}

// Borrow Queue - queue for items that are currently unavailable
model BorrowQueue {
  id          String            @id @default(cuid())
  itemId      String            @map("item_id")
  requesterId String            @map("requester_id")
  position    Int
  message     String?           @db.Text
  desiredFrom DateTime?         @map("desired_from")
  desiredTo   DateTime?         @map("desired_to")
  status      BorrowQueueStatus @default(WAITING)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([itemId, requesterId])
  @@index([itemId, position])
  @@index([requesterId])
  @@index([status])
  @@map("borrow_queue")
}

// Borrow Transaction - active borrow record
model BorrowTransaction {
  id              String                   @id @default(cuid())
  borrowRequestId String                   @unique @map("borrow_request_id")
  itemId          String                   @map("item_id")
  borrowerId      String                   @map("borrower_id")
  ownerId         String                   @map("owner_id")
  borrowedAt      DateTime                 @default(now()) @map("borrowed_at")
  // Reservation start — from the borrow request's desiredFrom. When in the future the
  // item is "Reserved" (still available now) rather than "Currently borrowed".
  startAt         DateTime?                @map("start_at")
  dueAt           DateTime                 @map("due_at")
  returnedAt      DateTime?                @map("returned_at")
  status          BorrowTransactionStatus  @default(ACTIVE)
  returnNote      String?                  @map("return_note") @db.Text
  // Occasion carried over from the borrow request (e.g. "Wedding"). Free text.
  event           String?                  @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  borrowRequest BorrowRequest @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower      User          @relation("Borrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  owner         User          @relation("TransactionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([borrowerId])
  @@index([ownerId])
  @@index([status])
  @@map("borrow_transactions")
}

// Notification model for alerts
model Notification {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  type      NotificationType
  entityId  String?            @map("entity_id") // ID of related entity (request, transaction, etc.)
  title     String
  body      String             @db.Text
  metadata  Json?              // Additional data for the notification
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now()) @map("created_at")
  readAt    DateTime?          @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, type, status])
  @@map("notifications")
}

model PushSubscription {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime? @map("expiration_time")
  userAgent      String?   @map("user_agent")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendAttempts PushSendAttempt[]

  @@index([userId, enabled])
  @@map("push_subscriptions")
}

model PushSendAttempt {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  pushSubscriptionId String?  @map("push_subscription_id")
  endpointHost       String   @map("endpoint_host") @db.VarChar(255)
  success            Boolean
  statusCode         Int?     @map("status_code")
  errorMessage       String?  @map("error_message") @db.Text
  errorBody          String?  @map("error_body") @db.Text
  payloadTag         String?  @map("payload_tag") @db.VarChar(128)
  purpose            String   @default("notification") @map("purpose") @db.VarChar(32)
  createdAt          DateTime @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscription PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("push_send_attempts")
}

// Per-user in-app vs push notification toggles (global, category, type)
model UserNotificationPreference {
  userId            String   @id @map("user_id")
  globalInApp       Boolean  @default(true) @map("global_in_app")
  globalPush        Boolean  @default(true) @map("global_push")
  categoryOverrides Json     @default("{}") @map("category_overrides")
  typeOverrides     Json     @default("{}") @map("type_overrides")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

// Non-production only: stores plaintext OTPs for e2e test retrieval.
// Rows are written only when NODE_ENV !== 'production' and email matches e2e+*@example.com.
model TestOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("test_otps")
}

model Feedback {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  rating          Int
  category        String
  message         String?  @db.Text
  currentPage     String?  @map("current_page")
  deviceType      String?  @map("device_type")
  appVersion      String?  @map("app_version")
  followUpConsent Boolean? @map("follow_up_consent")
  taskContext     String?  @map("task_context")
  attachmentPath  String?  @map("attachment_path")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("feedbacks")
}

// -----------------------------------------------------------------------------
// Impact / sustainability reference data (CIN = Circular Impact Network).
// Introspected from the live DB (prisma db pull) — these tables held reference
// data (emission factors, retail values, transport factors, methodology params)
// but were missing from the schema, which made `db push`/`migrate dev` want to
// drop them. They back the deferred Impact-tracking feature (CO2 / waste saved).
// -----------------------------------------------------------------------------

model cin_data_source_registry {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_key               String                     @unique
  source_name              String
  source_url               String
  publication_date         DateTime?                  @db.Date
  doi_or_report_id         String?
  publishing_org           String
  used_for                 String
  refresh_frequency_months Int
  last_reviewed_at         DateTime                   @db.Date
  next_review_due          DateTime?                  @default(dbgenerated("((last_reviewed_at + ((refresh_frequency_months)::double precision * '1 mon'::interval)))::date")) @db.Date
  refresh_owner            String?
  notes                    String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  cin_emissions_factors    cin_emissions_factors[]
  cin_retail_value_factors cin_retail_value_factors[]
  cin_transport_factors    cin_transport_factors[]
}

model cin_emissions_factors {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category                 String
  material                 String?
  kg_co2e_per_kg           Decimal                  @db.Decimal
  source_key               String
