# Database
DATABASE_URL="your_postgresql_url_here"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3003"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Supabase (for image storage)
NEXT_PUBLIC_SUPABASE_URL="your_supabase_project_url_here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Supabase Service Role Key (for server-side operations, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Test cleanup (Playwright)
TEST_CLEANUP_SECRET="your_test_cleanup_secret_here"

# Email — Resend (https://resend.com). Required in production for OTP and password reset.
# Leave RESEND_API_KEY blank in development to log emails instead of sending them.
# The sending domain must be verified in the Resend dashboard.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# EMAIL_FROM defaults to: ShareCircle <no-reply@circularimpact.org>
# EMAIL_FROM="ShareCircle <no-reply@circularimpact.org>"
#
# Absolute origin the email logo is loaded from. Defaults to NEXTAUTH_URL, which is already
# the public origin in production, so this is normally unnecessary. Mail clients cannot resolve
# a relative path and strip data: URIs, so the asset must be remotely hosted. A localhost value
# is detected and the email falls back to a text wordmark rather than a broken-image icon.
# EMAIL_ASSET_BASE_URL="https://app.example.com"

# Reverse geocoding contact address. Nominatim's usage policy expects an identifying
# contact in the User-Agent; requests without one can be rate limited or blocked.
# GEOCODE_CONTACT_EMAIL="support@circularimpact.org"

# PWA / Web Push (optional locally; required in production for background push)
# Production: set all three on your host (e.g. Vercel), redeploy, then test on HTTPS with an installed PWA.
# Generate keys: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_key"
# VAPID_PRIVATE_KEY="your_private_key"
# VAPID_SUBJECT="mailto:your-contact@example.com"

# E2E Testing flags
# E2E_AUTO_VERIFY=true - Auto-verify users during signup in E2E tests (disables email sending)
# SKIP_EMAIL=true - Disable all email sending (useful for local development/testing)

# Twilio SMS configuration (optional - for phone OTP)
# TWILIO_ACCOUNT_SID="your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_PHONE_NUMBER="+1234567890"
#
# SKIP_SMS=true - Disable all SMS sending (useful for local development/testing)
